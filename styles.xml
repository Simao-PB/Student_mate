<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme uses MaterialComponents -->
    <style name="Theme.NojiCards" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorBackground">@color/background</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button.UnelevatedButton</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>

    <!-- Card default -->
    <style name="Widget.MaterialComponents.CardView" parent="">
        <item name="android:layout_margin">8dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>
</resources>